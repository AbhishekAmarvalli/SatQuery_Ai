# ==========================================================================
# SATQUERY AI — live vision-language model (OPTIONAL)
#
# Copy this file to `.env`, set ONE provider and its key, then restart
# `npm run serve`.
#
# With NO .env the site still works end to end: it uses the built-in
# transparent rule engine instead. Live VLM is an upgrade, never a dependency.
#
# The browser never sees these values — scripts/serve.mjs proxies every
# request, exactly like the FastAPI service in the SIH architecture diagram.
# ==========================================================================

# ---------------------------------------------------------------- pick one --
# groq | gemini | openai | openrouter | local | mock
VLM_PROVIDER=groq


# ------------------------------- FREE option 1 (recommended): Groq + vision --
# Meta Llama 4 Scout accepts image input and speaks the OpenAI wire format.
# Free tier, very low latency.  Key: https://console.groq.com/keys
GROQ_API_KEY=

# ------------------------------- FREE option 2: Google Gemini free tier ------
# Multimodal on the free tier.  Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ------------------------------- Paid or alternative gateways ---------------
# OPENAI_API_KEY=        # https://platform.openai.com/api-keys
# OPENROUTER_API_KEY=    # free tiers available on :free models

# ------------------------------- Fully local, no API key at all --------------
# Self-hosted LLaVA behind any OpenAI-compatible server (Ollama, vLLM, LM Studio).
# This is the stack named in the SIH deck. Needs a GPU or a strong CPU.
# VLM_PROVIDER=local
# VLM_BASE_URL=http://127.0.0.1:11434/v1
# VLM_MODEL=llava


# ------------------------------------------------------- optional overrides --
# Override the model or point at your own gateway:
# VLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# VLM_BASE_URL=https://api.groq.com/openai/v1

# Send the AOI imagery to the model (default 1). Set to 0 for cheaper, faster
# text-only routing — the answer then no longer describes the actual scene.
# VLM_SEND_IMAGES=1


# ------------------------------------------------ offline self-test (no net) --
# Deterministic fake model used by `npm run verify` to exercise the live path.
# VLM_PROVIDER=mock
